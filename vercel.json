{
  "cleanUrls": true,
  "outputDirectory": ".",
  "functions": {
    "api/reminders/run.js": {
      "maxDuration": 180
    },
    "api/teacher/reminders/*.js": {
      "maxDuration": 150
    },
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/reminders/run?scheduledTest=20261010-sleep-03", "schedule": "0 18 * * *" },
    { "path": "/api/reminders/run?slot=00", "schedule": "0 0 * * *" },
    { "path": "/api/reminders/run?slot=01", "schedule": "0 1 * * *" },
    { "path": "/api/reminders/run?slot=02", "schedule": "0 2 * * *" },
    { "path": "/api/reminders/run?slot=03", "schedule": "0 3 * * *" },
    { "path": "/api/reminders/run?slot=04", "schedule": "0 4 * * *" },
    { "path": "/api/reminders/run?slot=05", "schedule": "0 5 * * *" },
    { "path": "/api/reminders/run?slot=06", "schedule": "0 6 * * *" },
    { "path": "/api/reminders/run?slot=07", "schedule": "0 7 * * *" },
    { "path": "/api/reminders/run?slot=08", "schedule": "0 8 * * *" },
    { "path": "/api/reminders/run?slot=09", "schedule": "0 9 * * *" },
    { "path": "/api/reminders/run?slot=10", "schedule": "0 10 * * *" },
    { "path": "/api/reminders/run?slot=11", "schedule": "0 11 * * *" },
    { "path": "/api/reminders/run?slot=12", "schedule": "0 12 * * *" },
    { "path": "/api/reminders/run?slot=13", "schedule": "0 13 * * *" },
    { "path": "/api/reminders/run?slot=14", "schedule": "0 14 * * *" },
    { "path": "/api/reminders/run?slot=15", "schedule": "0 15 * * *" },
    { "path": "/api/reminders/run?slot=16", "schedule": "0 16 * * *" },
    { "path": "/api/reminders/run?slot=17", "schedule": "0 17 * * *" },
    { "path": "/api/reminders/run?slot=18", "schedule": "0 18 * * *" },
    { "path": "/api/reminders/run?slot=19", "schedule": "0 19 * * *" },
    { "path": "/api/reminders/run?slot=20", "schedule": "0 20 * * *" },
    { "path": "/api/reminders/run?slot=21", "schedule": "0 21 * * *" },
    { "path": "/api/reminders/run?slot=22", "schedule": "0 22 * * *" },
    { "path": "/api/reminders/run?slot=23", "schedule": "0 23 * * *" }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/teacher", "destination": "/teacher/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/public/sw.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
