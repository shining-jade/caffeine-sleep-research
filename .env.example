# Apps Script web-app execution URL (server only)
GAS_API_URL=
# Shared Vercel-to-Apps-Script gateway secret (server only)
GAS_SHARED_SECRET=
# HMAC key for signed student and teacher sessions (server only)
SESSION_SECRET=
# Scrypt salt generated by scripts/hash-teacher-password.mjs (server only)
TEACHER_PASSWORD_SALT=
# Scrypt hash generated by scripts/hash-teacher-password.mjs (server only)
TEACHER_PASSWORD_HASH=
# Web Push VAPID public key returned to authenticated clients
WEB_PUSH_VAPID_PUBLIC_KEY=
# Web Push VAPID private key (server only)
WEB_PUSH_VAPID_PRIVATE_KEY=
# VAPID contact subject, for example a monitored mailto address
WEB_PUSH_SUBJECT=
# Authorization secret for Vercel Cron reminder invocations (server only)
CRON_SECRET=
